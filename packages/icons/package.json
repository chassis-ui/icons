{
  "name": "@chassis-ui/icons",
  "version": "0.4.0",
  "type": "module",
  "description": "The builder of icon sets of Chassis UI: the chassis-icons command, which builds a repository of SVG files into optimized SVG files, an SVG sprite and an icon font with its stylesheets",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chassis-ui/icons.git",
    "directory": "packages/icons"
  },
  "bugs": {
    "url": "https://github.com/chassis-ui/icons/issues"
  },
  "homepage": "https://chassis-ui.com/icons/",
  "author": "Ozgur Gunes <o.gunes@gmail.com>",
  "license": "MIT",
  "keywords": [
    "chassis",
    "design system",
    "icons",
    "icon font",
    "svg",
    "svg sprite",
    "fantasticon",
    "icon generator"
  ],
  "bin": {
    "chassis-icons": "lib/cli.js"
  },
  "files": [
    "lib",
    "templates",
    "README.md",
    "CHANGELOG.md"
  ],
  "exports": {
    "./lib/*": "./lib/*",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "lint:package": "publint --strict",
    "test": "vitest run --dir test",
    "test:golden": "node test/update-golden.js",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "clean-css": "^5.3.3",
    "fantasticon": "^4.1.0",
    "handlebars": "^4.7.10",
    "picocolors": "^1.1.1",
    "svg-sprite": "3.0.0-rc3",
    "svg2vectordrawable": "^2.9.1",
    "svgo": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "publint": "^0.3.25",
    "vitest": "^5.1.0"
  }
}
