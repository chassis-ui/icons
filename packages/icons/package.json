{
  "name": "@chassis-ui/icons",
  "version": "0.4.0-next.0",
  "type": "module",
  "description": "The icons of the Chassis Design System, in outline, solid and brand styles, as an icon font, an SVG sprite and optimized SVG files.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chassis-ui/icons.git",
    "directory": "packages/icons"
  },
  "bugs": {
    "url": "https://github.com/chassis-ui/icons/issues"
  },
  "homepage": "https://chassis-ui.com/icons/",
  "author": "Ozgur Gunes <o.gunes@gmail.com>",
  "license": "MIT",
  "keywords": [
    "chassis",
    "design system",
    "icons",
    "icon font",
    "svg",
    "svg sprite",
    "fantasticon",
    "icon generator"
  ],
  "main": "icons/chassis-icons.css",
  "style": "icons/chassis-icons.css",
  "sass": "icons/chassis-icons.scss",
  "files": [
    "icons/chassis-icons.*",
    "svgs/*.svg"
  ],
  "exports": {
    ".": {
      "sass": "./icons/chassis-icons.scss",
      "style": "./icons/chassis-icons.css",
      "default": "./icons/chassis-icons.css"
    },
    "./icons/*": "./icons/*",
    "./svgs/*": "./svgs/*",
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "*.css",
    "*.scss"
  ],
  "chassis": {
    "build": {
      "name": "chassis-icons",
      "prefix": "cx",
      "source": "../../source",
      "frame": 24,
      "styles": [
        "outline",
        "solid",
        "brand"
      ],
      "pairs": [
        [
          "outline",
          "solid"
        ]
      ],
      "startCodepoint": "f101",
      "formats": [
        "woff2",
        "woff"
      ],
      "header": [
        "Chassis Icons v{version}",
        "Copyright 2025 Ozgur Gunes",
        "Licensed under MIT (https://github.com/chassis-ui/icons/blob/main/LICENSE)"
      ]
    }
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "node build/cli.js build",
    "font": "node build/cli.js build --only font",
    "init": "node build/cli.js init",
    "lint:package": "publint --strict",
    "lint:source": "node build/cli.js lint-source",
    "sprite": "node build/cli.js build --only sprite",
    "svgs": "node build/cli.js build --only svgs",
    "test": "vitest run --dir test",
    "test:golden": "node test/update-golden.js",
    "typecheck": "tsc -p tsconfig.json",
    "verify": "node build/cli.js verify"
  },
  "devDependencies": {
    "@twbs/fantasticon": "^3.1.0",
    "@types/node": "^22.20.4",
    "clean-css": "^5.3.3",
    "handlebars": "^4.7.9",
    "picocolors": "^1.1.1",
    "publint": "^0.3.25",
    "svg-sprite": "3.0.0-rc3",
    "svgo": "^4.1.0",
    "vitest": "^5.0.2"
  }
}
