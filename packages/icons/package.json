{
  "name": "@chassis-ui/icons",
  "version": "0.3.1",
  "type": "module",
  "description": "Comprehensive SVG icon library for Chassis Design System. Features optimized icons with automated font generation, sprite creation, and multi-format distribution for web and mobile applications.",
  "repository": {
    "type": "git",
    "url": "https://github.com/chassis-ui/icons.git",
    "directory": "packages/icons"
  },
  "bugs": {
    "url": "https://github.com/chassis-ui/icons/issues"
  },
  "homepage": "https://chassis-ui.com",
  "author": "Ozgur Gunes <o.gunes@gmail.com>",
  "license": "MIT",
  "keywords": [
    "chassis",
    "design system",
    "icons",
    "icon font",
    "svg",
    "svg sprite",
    "fantasticon",
    "icon generator"
  ],
  "main": "icons/chassis-icons.css",
  "style": "icons/chassis-icons.css",
  "sass": "icons/chassis-icons.scss",
  "files": [
    "icons/*.{woff,woff2,css,scss,svg,json}",
    "svgs/*.svg",
    "!.DS_Store"
  ],
  "chassis": {
    "build": {
      "name": "chassis-icons",
      "prefix": "cx",
      "source": "../../source",
      "frame": 24,
      "styles": [
        "outline",
        "solid",
        "brand"
      ],
      "pairs": [
        [
          "outline",
          "solid"
        ]
      ],
      "startCodepoint": "f101",
      "formats": [
        "woff2",
        "woff"
      ],
      "header": [
        "Chassis Icons v{version}",
        "Copyright 2025 Ozgur Gunes",
        "Licensed under MIT (https://github.com/chassis-ui/icons/blob/main/LICENSE)"
      ]
    }
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "node build/cli.js build",
    "check": "node build/check-icons.js",
    "font": "node build/cli.js build --only font",
    "init": "node build/cli.js init",
    "sprite": "node build/cli.js build --only sprite",
    "svgs": "node build/cli.js build --only svgs",
    "zip": "node build/zip-icons.js"
  },
  "devDependencies": {
    "@twbs/fantasticon": "^3.1.0",
    "clean-css": "^5.3.3",
    "handlebars": "^4.7.9",
    "picocolors": "^1.1.1",
    "svg-sprite": "3.0.0-rc3",
    "svgo": "^3.3.3"
  }
}
