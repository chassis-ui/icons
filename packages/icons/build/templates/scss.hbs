/*!
{{# each header }}
 * {{{ this }}}
{{/ each }}
 */

${{ name }}-font: "{{ name }}" !default;
${{ name }}-font-dir: "{{ fontsUrl }}" !default;
${{ name }}-font-file: "#{${{ name }}-font-dir}/#{${{ name }}-font}" !default;
${{ name }}-font-hash: "{{ fontHash }}" !default;
${{ name }}-font-src:
{{# each formats }}
  url("#{${{ ../name }}-font-file}.{{ extension }}?#{${{ ../name }}-font-hash}") format("{{ format }}"){{# if @last }} !default;{{ else }},{{/ if }}
{{/ each }}

@font-face {
  font-display: block;
  font-family: ${{ name }}-font;
  src: ${{ name }}-font-src;
}

@layer content {
  [class^="{{ prefix }}-"]::before,
  [class*=" {{ prefix }}-"]::before {
    display: inline-block;
    font-family: ${{ name }}-font !important;
    font-style: normal;
    font-weight: normal !important;
    font-variant: normal;
    text-transform: none;
    line-height: 1;
    vertical-align: -.125em;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
  }
}

${{ name }}-map: (
{{# each codepoints }}
  "{{ @key }}": "\\{{ codepoint this }}",
{{/ each }}
);

@each $icon, $codepoint in ${{ name }}-map {
  .{{ prefix }}-#{$icon}::before { content: $codepoint; }
}
