---
import IconsLayout from '@layouts/IconsLayout.astro'
import { groupIcons } from '@libs/content'
import ListSection from '@components/homepage/ListSection.astro'

export async function getStaticPaths() {
  return [...groupIcons('categories')].map(([category, icons]) => ({
    params: { category },
    props: { category, icons }
  }))
}

const { category, icons } = Astro.props
const count = icons.length

const frontmatter = {
  title: `${category.charAt(0).toUpperCase() + category.slice(1)} category`,
  description: `Browse ${count} icons in "${category}" category`
}
---

<IconsLayout frontmatter={frontmatter}>
  <nav aria-label="breadcrumb" class="container 2xl pt-md">
    <div class="border-bottom border-subtle mb-md">
      <ol class="breadcrumb">
        <li class="breadcrumb-item">
          <a href="/icons/">Icons</a>
        </li>
        <li class="breadcrumb-item">
          <a href="/icons/browse/">Browse</a>
        </li>
        <li class="breadcrumb-item active" aria-current="page">
          {category}
        </li>
      </ol>
    </div>
  </nav>
  <div class="container 2xl">
    <h1>{frontmatter.title}</h1>
    <p class="lead">{frontmatter.description}</p>
  </div>
  <ListSection icons={icons} title={`${count} icons in ${category} category`} />
</IconsLayout>
