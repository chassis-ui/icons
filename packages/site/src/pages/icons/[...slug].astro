---
import IconsLayout from '@layouts/IconsLayout.astro'
import { iconsPages } from '@libs/content'
import Details from '@components/Details.astro'
import '@scss/_icons.scss'

export async function getStaticPaths() {
  // The name of the icon is the id of its entry, its title and its page
  return iconsPages.map((iconsPage) => ({
    params: { slug: iconsPage.id },
    props: iconsPage
  }))
}

const { id, data } = Astro.props
---

<IconsLayout frontmatter={data} id={id}>
  <Details icon={data} />
</IconsLayout>
