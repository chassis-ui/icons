---
import BaseLayout from '@chassis-ui/docs/layouts/BaseLayout.astro'
import HeroSection from '@components/homepage/HeroSection.astro'
import IntroSection from '@components/homepage/IntroSection.astro'
import HowSection from '@components/homepage/HowSection.astro'
import OutputSection from '@components/homepage/OutputSection.astro'
import UsageSection from '@components/homepage/UsageSection.astro'
import ChecksSection from '@components/homepage/ChecksSection.astro'
import TechSection from '@components/homepage/TechSection.astro'
import DocsSection from '@components/homepage/DocsSection.astro'
import HomeIcons from '/static/icons/cx-sprite.svg?raw'
---

<BaseLayout title="Chassis Icons - The builder of icon sets of Chassis UI">
  <!-- Hero Section -->
  <HeroSection />
  <hr class="hr container" />
  <!-- A repository of icons per team -->
  <IntroSection />
  <!-- From the SVG files to a release -->
  <HowSection />
  <!-- What a build writes -->
  <OutputSection />
  <!-- The ways to use an icon -->
  <UsageSection />
  <!-- The source lint and verify -->
  <ChecksSection />
  <!-- The tools of the build -->
  <TechSection />
  <!-- Documentation Section -->
  <DocsSection />
  <div class="d-none">
    <Fragment set:html={HomeIcons} />
  </div>
</BaseLayout>
