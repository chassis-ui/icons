---
import IconsLayout from '@layouts/IconsLayout.astro'
import HeroSection from '@components/homepage/HeroSection.astro'
import ListSection from '@components/homepage/ListSection.astro'
import BuildSection from '@components/homepage/BuildSection.astro'
import UsageSection from '@components/homepage/UsageSection.astro'
import StylingSection from '@components/homepage/StylingSection.astro'
import AccessibilitySection from '@components/homepage/AccessibilitySection.astro'
import SVGSection from '@components/homepage/SVGSection.astro'
import set from 'virtual:icon-set'
import { iconsPages } from '@libs/content'
import HomeIcons from '/static/icons/cx-sprite.svg?raw'
import '@scss/_icons.scss'
---

<IconsLayout frontmatter={{ title: set.title }} id="icons-layout">
  <HeroSection />
  <nav
    class="container 2xl sticky-top bg-main mb-6xl"
    aria-label="Icons Navigation"
    style="top: 4rem; z-index: 10;"
  >
    <ul id="icons-nav" class="nav nav-underline justify-content-center">
      <li class="nav-item">
        <a class="nav-link py-xs" href="#build-section">
          Build
        </a>
      </li>
      <li class="nav-item">
        <a class="nav-link py-xs" href="#icons-section">
          Icons
        </a>
      </li>
      <li class="nav-item">
        <a class="nav-link py-xs" href="#usage-section">
          Usage
        </a>
      </li>
      <li class="nav-item">
        <a class="nav-link py-xs" href="#styling-section">
          Styling
        </a>
      </li>
      <li class="nav-item">
        <a class="nav-link py-xs" href="#accessibility-section">
          Accessibility
        </a>
      </li>
    </ul>
  </nav>
  <BuildSection />
  <ListSection lead={`${set.package.description} The set has ${iconsPages.length} icons.`} />
  <UsageSection />
  <StylingSection />
  <AccessibilitySection />
  <SVGSection />
  <div class="d-none">
    <Fragment set:html={HomeIcons} />
  </div>
</IconsLayout>
