---
import IconsLayout from '@layouts/IconsLayout.astro'
import { groupIcons, iconsPages } from '@libs/content'

// The categories and the tags, each with the number of its icons, the largest first
const count = (field: 'categories' | 'tags') =>
  [...groupIcons(field)]
    .map(([value, icons]): [string, number] => [value, icons.length])
    .sort((a, b) => b[1] - a[1])

const sortedCategories = count('categories')
const sortedTags = count('tags')

const frontmatter = {
  title: 'Browse Icons by Category & Tags',
  description: `Explore ${iconsPages.length} icons organized by categories and tags`
}
---

<IconsLayout frontmatter={frontmatter}>
  <div class="container 2xl">
    <nav aria-label="breadcrumb" class="pt-md">
      <div class="border-bottom border-subtle mb-md">
        <ol class="breadcrumb">
          <li class="breadcrumb-page"><a href="/icons/">Icons</a></li>
          <li class="breadcrumb-page"><a href="/icons/browse/">Browse</a></li>
        </ol>
      </div>
    </nav>
    <div class="border-bottom border-subtle">
      <h1>{frontmatter.title}</h1>
      <p class="lead">{frontmatter.description}</p>
    </div>

    <div class="row my-2xl">
      <div class="md:col-6">
        <h2>Categories</h2>
        <p class="text-muted">Icons grouped by primary function or theme</p>
        <div class="d-flex flex-wrap gap-md mb-4">
          {
            sortedCategories.map(([category, count]) => (
              <a href={`/icons/category/${category}/`} class="button default sm">
                {category.charAt(0).toUpperCase() + category.slice(1)}
                <span class="badge primary smooth ms-2xs">{count}</span>
              </a>
            ))
          }
        </div>
      </div>

      <div class="md:col-6">
        <h2>Tags</h2>
        <p class="text-muted">Icons labeled by style, type, or characteristics</p>
        <div class="d-flex flex-wrap gap-md mb-4">
          {
            sortedTags.map(([tag, count]) => (
              <a href={`/icons/tag/${tag}/`} class="button default sm">
                {tag}
                <span class="badge primary smooth ms-2xs">{count}</span>
              </a>
            ))
          }
        </div>
      </div>
    </div>

    <section class="p-xl mb-2xl bg-even rounded">
      <h3 class="font-xl fg-subtle">Quick Stats</h3>
      <div class="row text-center">
        <div class="col-4">
          <div class="font-5xl font-strong">{iconsPages.length}</div>
          <div>Total Icons</div>
        </div>
        <div class="col-4">
          <div class="font-5xl font-strong">{sortedCategories.length}</div>
          <div>Categories</div>
        </div>
        <div class="col-4">
          <div class="font-5xl font-strong">{sortedTags.length}</div>
          <div>Tags</div>
        </div>
      </div>
    </section>
  </div></IconsLayout
>
