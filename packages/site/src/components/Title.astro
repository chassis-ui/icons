---
import type { CollectionEntry } from 'astro:content'
import { getSlug } from '@chassis-ui/docs'

interface Props {
  icon: CollectionEntry<'icons'>['data']
}

const { title, categories, tags } = Astro.props.icon
---

<div class="d-flex flex-column mb-md">
  <nav aria-label="breadcrumb">
    <div class="border-bottom border-subtle mb-md pt-md">
      <ol class="breadcrumb">
        <li class="breadcrumb-item">
          <a href="/icons/">Icons</a>
        </li>
        <li class="breadcrumb-item active" aria-current="page">
          {title}
        </li>
      </ol>
    </div>
  </nav>
  <h1 class="cxd-title mb-0" id="title">
    {title}
  </h1>
  <div>
    <ul class="bulletless mb-md">
      <li class="my-xs">
        <strong>Tags:</strong>{' '}
        {tags.map((tag) => (
          <>
            <a class="badge default ms-2xs" href={`/icons/tag/${getSlug(tag)}/`}>
              {tag}
            </a>{' '}
          </>
        ))}
      </li>
      <li>
        <strong>Category:</strong>{' '}
        {categories.map((category) => (
          <>
            <a class="badge default ms-2xs" href={`/icons/category/${getSlug(category)}/`}>
              {category}
            </a>{' '}
          </>
        ))}
      </li>
    </ul>
  </div>
</div>
