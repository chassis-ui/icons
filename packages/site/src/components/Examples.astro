---
import type { CollectionEntry } from 'astro:content'
import SetIcon from '@components/SetIcon.astro'

interface Props {
  icon: CollectionEntry<'icons'>['data']
}

const { icon } = Astro.props
---

<h2 class="font-strong">Examples</h2>
<div class="p-md md:p-lg border rounded icon-demo-examples">
  <div class="h1 align-items-center">
    <SetIcon name={icon.title} class="icon-adaptive" /> Heading
  </div>
  <div class="h3">
    <SetIcon name={icon.title} class="icon-adaptive" /> Smaller heading
  </div>
  <p>
    Inline text <SetIcon name={icon.title} class="icon-adaptive" />
  </p>
  <p>
    <a href="#content" class="text-decoration-none">
      Example link text <SetIcon name={icon.title} class="icon-adaptive" />
    </a>
  </p>
  <div class="d-flex gap-sm mb-md">
    <button type="button" class="button default">
      <SetIcon name={icon.title} />
      <span>Button</span>
    </button>
    <button type="button" class="button primary">
      <SetIcon name={icon.title} />
      <span>Button</span>
    </button>
    <button type="button" class="button primary outline">
      <SetIcon name={icon.title} />
      <span>Button</span>
    </button>
    <button type="button" class="button primary smooth">
      <SetIcon name={icon.title} />
      <span>Button</span>
    </button>
  </div>
  <div class="d-flex gap-sm mb-md">
    <button type="button" class="button default icon-only">
      <SetIcon name={icon.title} />
      <span class="visually-hidden">Button</span>
    </button>
    <button type="button" class="button secondary icon-only">
      <SetIcon name={icon.title} />
      <span class="visually-hidden">Button</span>
    </button>
    <div class="button-group">
      <button type="button" class="button default icon-only">
        <SetIcon name={icon.title} />
        <span class="visually-hidden">Button</span>
      </button>
      <button type="button" class="button default icon-only">
        <SetIcon name={icon.title} />
        <span class="visually-hidden">Button</span>
      </button>
      <button type="button" class="button default icon-only">
        <SetIcon name={icon.title} />
        <span class="visually-hidden">Button</span>
      </button>
    </div>
    <div class="button-group">
      <button type="button" class="button secondary icon-only">
        <SetIcon name={icon.title} />
        <span class="visually-hidden">Button</span>
      </button>
      <button type="button" class="button secondary icon-only">
        <SetIcon name={icon.title} />
        <span class="visually-hidden">Button</span>
      </button>
      <button type="button" class="button secondary icon-only">
        <SetIcon name={icon.title} />
        <span class="visually-hidden">Button</span>
      </button>
    </div>
  </div>
  <div class="mb-md">
    <div class="input-group">
      <span class="input-addon" id="basic-addon1">
        <SetIcon name={icon.title} />
      </span>
      <input
        type="text"
        class="form-input"
        placeholder="Input group example"
        aria-label="Input group example"
        aria-describedby="basic-addon1"
      />
    </div>
  </div>
  <div class="notification success" role="alert">
    <SetIcon name={icon.title} class="notification-icon" />
    <p>An example notification with an icon!</p>
  </div>
</div>
