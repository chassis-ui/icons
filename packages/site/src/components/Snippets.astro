---
import type { CollectionEntry } from 'astro:content'
import set from 'virtual:icon-set'
import Code from '@chassis-ui/docs/shortcodes/Code.astro'
import { svgPath } from '@libs/icon'

interface Props {
  icon: CollectionEntry<'icons'>['data']
}

// The name, the SVG file and the code point are what the build wrote for the icon, and the
// class and the sprite are those of the configuration of the set.
const { title: name, svg, codepoint } = Astro.props.icon
---

<div class="mb-lg">
  <h3 class="mb-0">Download</h3>
  <p>Download the SVG to use or edit.</p>
  <a href={svgPath(name)} class="button lg primary" download>
    Download SVG
  </a>

  <h3 class="mb-0">SVG sprite</h3>
  <p>
    Draw the symbol of the sprite with a <code>&lt;use&gt;</code> element.
  </p>
  <div>
    <Code
      noToolbar
      lang="html"
      code={`<svg width="${set.frame}" height="${set.frame}" fill="currentcolor" aria-hidden="true">
  <use href="${set.name}.svg#${name}"></use>
</svg>`}
    />
  </div>

  <h3 class="mb-0">Icon font</h3>
  <p>Put the class of the icon on an empty element.</p>
  <div>
    <Code noToolbar lang="html" code={`<i class="${set.prefix}-${name}"></i>`} />
  </div>

  <h3 class="mb-0">Embedded</h3>
  <p>Paste the SVG right into your project's code.</p>
  <Code noToolbar lang="html" code={svg.trim()} />

  <h3 class="mb-0">Code point</h3>
  <p>Paste the code point into your project.</p>
  <div class="mb-md">
    <dl class="grid grid-cols-4 column-gap-xl row-gap-0">
      <dt class="col-span-full sm:col-span-1">Unicode:</dt>
      <dd class="col-span-full sm:col-span-3">
        <code>U+{codepoint}</code>
      </dd>

      <dt class="col-span-full sm:col-span-1">CSS:</dt>
      <dd class="col-span-full sm:col-span-3">
        <code>\{codepoint}</code>
      </dd>

      <dt class="col-span-full sm:col-span-1">JS:</dt>
      <dd class="col-span-full sm:col-span-3">
        <code>\u{codepoint}</code>
      </dd>

      <dt class="col-span-full sm:col-span-1">HTML:</dt>
      <dd class="col-span-full sm:col-span-3">
        <code>&amp;#x{codepoint};</code>
      </dd>
    </dl>
  </div>
</div>
