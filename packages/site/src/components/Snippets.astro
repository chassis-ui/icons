---
import path from 'path'
import type { CollectionEntry } from 'astro:content'
import { readFileSync } from 'fs'
import Code from '@chassis-ui/docs/shortcodes/Code.astro'
import { getSiteFsPath } from '@chassis-ui/docs/site'

interface Props {
  icon: CollectionEntry<'icons'>['data']
}

const { icon } = Astro.props

// The icons are in the root of the repository, one folder above the site's root.
const svgCode = readFileSync(getSiteFsPath(`../icons/svgs/${icon.title}.svg`), 'utf-8')
const codepoints = JSON.parse(
  readFileSync(getSiteFsPath('../icons/icons/chassis-icons.json'), 'utf-8')
)
const hexCodepoint = parseInt(codepoints[icon.title]).toString(16).toUpperCase()
---

<div class="col-lg-4 mb-lg">
  <h3 class="mb-0">Download</h3>
  <p>Download the SVG to use or edit.</p>
  <a href={path.join('/static/icons', `${icon.title}.svg`)} class="button lg primary" download
    >Download SVG</a
  >

  <h3 class="mb-0">SVG sprite</h3>
  <p>Use this code for svg icons.</p>
  <div>
    <Code noToolbar lang="html" code={`<svg><use xlink:href="#${icon.title}"/></svg>`} />
  </div>

  <h3 class="mb-0">Icon font</h3>
  <p>Using the web font with a span element.</p>
  <div>
    <Code noToolbar lang="html" code={`<span class="icon cx-${icon.title}"></span>`} />
  </div>

  <h3 class="mb-0">Embedded</h3>
  <p>Paste the SVG right into your project's code.</p>
  <Code noToolbar lang="html" code={svgCode} />

  <h3 class="mb-0">Code point</h3>
  <p>Paste the code point into your project.</p>
  <div class="mb-md">
    <dl class="row">
      <dt class="sm:col-3">Unicode:</dt>
      <dd class="sm:col-9"><code>U+{hexCodepoint}</code></dd>

      <dt class="sm:col-3">CSS:</dt>
      <dd class="sm:col-9"><code>\{hexCodepoint}</code></dd>

      <dt class="sm:col-3">JS:</dt>
      <dd class="sm:col-9"><code>\u{hexCodepoint}</code></dd>

      <dt class="sm:col-3">HTML:</dt>
      <dd class="sm:col-9"><code>&amp;#x{hexCodepoint};</code></dd>
    </dl>
  </div>
</div>
