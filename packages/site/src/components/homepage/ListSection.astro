---
import SetIcon from '@components/SetIcon.astro'
import { iconsPages, type IconPage } from '@libs/content'

interface Props {
  icons?: IconPage[]
  /** A paragraph under the title, such as what the set is. */
  lead?: string
  showSearch?: boolean
  title?: string
}

const { icons = iconsPages, lead, showSearch = true, title = 'Icons' } = Astro.props
---

<section id="icons-section" class="home-section py-xl">
  <div class="container 2xl section-content">
    <header class:list={['d-flex mt-2xl', lead ? 'mb-md' : 'mb-2xl']}>
      <h2 id="icons">{title}</h2>
      {
        showSearch && (
          <form class="flex-nowrap ms-auto" onsubmit="return false">
            <label for="search" class="visually-hidden">
              Search for icons
            </label>
            <input
              class="form-input search mb-0"
              id="search"
              type="search"
              placeholder="Start typing to filter..."
              autocomplete="off"
            />
            <button type="submit" hidden>
              Search
            </button>
          </form>
        )
      }
    </header>
    {lead && <p class="mb-2xl lg:col-8">{lead}</p>}
    <ul
      id="icons-list"
      class="row row-cols-3 gy-md sm:row-cols-4 lg:row-cols-6 xl:row-cols-8 bulletless icons-list icon-xl"
      data-pagefind-ignore
    >
      {
        icons.map(({ id: name, data }) => (
          <li
            class="col"
            data-name={name}
            data-tags={data.tags.join(' ').toLowerCase()}
            data-categories={data.categories.join(' ').toLowerCase()}
          >
            <a class="d-block text-decoration-none" href={`/icons/${name}/`}>
              <div class="bg-even py-3xl text-center rounded">
                <SetIcon name={name} />
              </div>
              <div class="name text-muted text-decoration-none text-center">{name}</div>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>
<Fragment slot="scripts">
  <script src="../../assets/icon-search.js"></script>
</Fragment>
