---
import set from 'virtual:icon-set'
import Example from '@chassis-ui/docs/shortcodes/Example.astro'
import Code from '@chassis-ui/docs/shortcodes/Code.astro'
import { fontIcon, spriteIcon } from '@libs/icon'

const name = set.exampleIcon
const { frame } = set
---

<section id="styling-section" class="home-section py-3xl md:py-6xl">
  <div class="container 2xl section-content">
    <div class="row mb-3xl md:mb-6xl">
      <header class="section-header col lg:col-10 xl:col-8">
        <h2 id="styling">Styling</h2>
        <p>
          <a href="https://chassis-ui.com/css">Chassis CSS</a> styles an element with the class <code
            >icon</code
          >, whatever set the icon is of. It reads the size and the color from <code
            >--cx-icon-size</code
          > and <code>--cx-icon-color</code>, and its utilities set both.
        </p>
      </header>
    </div>

    <div class="row my-lg">
      <div class="md:col-4">
        <h3>Utilities</h3>
        <p>
          You can use <code>icon-*</code> classes to change both their size and colors. Put any <em
            >context color</em
          > or <em>icon size</em> after.
        </p>
      </div>
      <div class="md:col-8">
        <Example code={[spriteIcon(name), spriteIcon(name, 'icon-info icon-xl')]} />
      </div>
    </div>

    <div class="row my-lg">
      <div class="md:col-4">
        <h3>Adaptive</h3>
        <p>
          Put <code>.icon-adaptive</code> and
          <code>.icon-reset</code> to change their values to <code>--cx-font-size</code> and <code
            >--cx-fg-color</code
          >.
        </p>
      </div>
      <div class="md:col-8">
        <Example
          code={`<h2 class="fg-subtle">
  ${spriteIcon(name, 'icon-adaptive icon-reset')}
  Heading
</h2>`}
        />
      </div>
    </div>

    <div class="row my-lg">
      <div class="md:col-4">
        <h3>Context Colors</h3>
        <p>
          Icons color and sizes fit to context and components automatically. Context object color
          utilities are also available. Put <code>.*-icon-main</code> or <code>.*-icon-subtle</code> classes
          to change their <code>color</code> ad <code>fill-color</code> properties directly with an <code
            >!important</code
          > flag.
        </p>
        <p>
          Note that, <code>.icon-primary</code> and <code>.primary-icon-main</code> are different colors.
          While <code>.primary-icon-main</code> using <code>--cx-primary-icon-main</code> color, <code
            >.icon-primary</code
          > uses <code>--cx-primary-base-color</code> for its property.
        </p>
      </div>
      <div class="md:col-8">
        <Example
          code={`<div class="context secondary p-md">
  ${spriteIcon(name)}
  ${spriteIcon(name, 'icon-subtle icon-md')}

  ${fontIcon(name, 'fg-subtle icon-2xl')}
  ${fontIcon(name, 'primary-icon-main')}
  ${fontIcon(name, 'primary-fg-main icon-xs')}
</div>`}
        />
      </div>
    </div>

    <div class="row my-lg">
      <div class="md:col-4">
        <h3>CSS</h3>
        <p>
          You can also use the SVG within your CSS (<strong>be sure to escape any characters</strong
          >, such as <code>#</code> to <code>%23</code> when specifying hex color values). When no dimensions
          are specified via <code>width</code> and <code>height</code> on the <code
            >&lt;svg&gt;</code
          >, the icon will fill the available space.
        </p>
        <p>
          The <code>viewBox</code> attribute is required if you wish to resize icons with <code
            >background-size</code
          >. Note that the <code>xmlns</code> attribute is required.
        </p>
        <p>
          Note that, it is not possible to change color if SVG used as <code>background-image</code
          >. A <code>mask-image</code> takes the color of <code>background-color</code>.
        </p>
      </div>
      <div class="md:col-8">
        <Code
          lang="css"
          code={`.icon-bg::before {
  display: inline-block;
  content: "";
  vertical-align: -.125em;
  background-image: url("data:image/svg+xml,<svg viewBox='0 0 ${frame} ${frame}' fill='%23ff5b14' xmlns='http://www.w3.org/2000/svg'><path fill-rule='evenodd' d='M8 9.5a1.5 1.5 0 1 0 0-3 1.5 1.5 0 0 0 0 3z' clip-rule='evenodd'/></svg>");
  background-repeat: no-repeat;
  background-size: 1rem 1rem;
}`}
        />
        <Code
          lang="css"
          code={`.icon-mask::before {
  position: absolute;
  width: 1rem;
  height: 1rem;
  margin-top: 0;
  margin-left: .5rem;
  content: "";
  background-color: #ff5b14;
  mask-image: url("data:image/svg+xml,<svg viewBox='0 0 ${frame} ${frame}' fill='currentColor' xmlns='http://www.w3.org/2000/svg'><path fill-rule='evenodd' d='M8 9.5a1.5 1.5 0 1 0 0-3 1.5 1.5 0 0 0 0 3z' clip-rule='evenodd'/></svg>");
  mask-position: center;
  mask-size: 1rem 1rem;
}`}
        />
      </div>
    </div>
  </div>
</section>
