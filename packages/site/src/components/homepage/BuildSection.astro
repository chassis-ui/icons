---
import set from 'virtual:icon-set'
import FeatureCard from '@chassis-ui/docs/components/FeatureCard.astro'
import Code from '@chassis-ui/docs/shortcodes/Code.astro'
import { iconsPages } from '@libs/content'

// The first files of the set, as an example of the source folder
const files = iconsPages.slice(0, 3).map((page) => `├── ${page.id}.svg`)

// A published package is on a CDN. The stylesheet of a private one is served by its project.
const { name: packageName, version } = set.package
const stylesheet = set.package.private
  ? `icons/${set.name}.min.css`
  : `https://cdn.jsdelivr.net/npm/${packageName}@${version}/icons/${set.name}.min.css`
---

<section id="build-section" class="home-section py-3xl md:py-6xl">
  <div class="container 2xl section-content">
    <div class="row mb-3xl md:mb-6xl">
      <header class="section-header col lg:col-10 xl:col-8">
        <h2 id="build">Build</h2>
        <p>
          {set.title} is built from one folder of SVG files. Save a file per icon, run the build, and
          load the stylesheet or the sprite that it writes. A team that owns the repository builds a set
          of its own the same way: with its files, its font name and its class prefix.
        </p>
      </header>
    </div>

    <div class="row row-cols-1 md:row-cols-3 g-md md:g-xl">
      <div class="col">
        <FeatureCard icon="cx-folders">
          <Fragment slot="title">Save Files</Fragment>
          <Fragment slot="body"
            >Save one SVG file per icon into the source folder. The name of the file is the name of
            the icon.</Fragment
          >
          <div class="border-top border-subtle pt-md">
            <Code noToolbar lang="text" code={['source/', ...files, '└── ...'].join('\n')} />
          </div>
        </FeatureCard>
      </div>
      <div class="col">
        <FeatureCard icon="cx-check-circle">
          <Fragment slot="title">Build Icons</Fragment>
          <Fragment slot="body"
            >The build optimizes the files and writes the sprite, the icon font and its stylesheets.</Fragment
          >
          <div class="border-top border-subtle pt-md">
            <Code
              noToolbar
              lang="shell"
              code={`# Check the files
pnpm icons:lint:source

# Build the set
pnpm icons`}
            />
          </div>
        </FeatureCard>
      </div>
      <div class="col">
        <FeatureCard icon="cx-figma">
          <Fragment slot="title">Import Files</Fragment>
          <Fragment slot="body">Load the stylesheet of the icon font in a page or in CSS.</Fragment>
          <div class="border-top border-subtle pt-md">
            <Code
              noToolbar
              lang="html"
              code={`<!-- HTML -->
<link rel="stylesheet" href="${stylesheet}">`}
            />
            <Code
              noToolbar
              lang="css"
              containerClass="mt-nmd"
              code={`/* CSS */
@import url("${stylesheet}");`}
            />
          </div>
        </FeatureCard>
      </div>
    </div>
  </div>
</section>
