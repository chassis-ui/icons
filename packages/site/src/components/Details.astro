---
import type { CollectionEntry } from 'astro:content'
import Title from '@components/Title.astro'
import Examples from '@components/Examples.astro'
import Snippets from '@components/Snippets.astro'
import SetIcon from '@components/SetIcon.astro'

interface Props {
  icon: CollectionEntry<'icons'>['data']
}

const { icon } = Astro.props
---

<div class="container 2xl">
  <Title icon={icon} />
  <div class="row mb-xl">
    <div class="md:col-8">
      <div
        class="icon-demo border rounded d-flex align-items-center justify-content-center"
        style="font-size: 10rem;"
        role="img"
        aria-label={`${icon.title} - lg preview`}
      >
        <SetIcon name={icon.title} class="icon-adaptive" />
      </div>
      <div data-pagefind-ignore>
        <Examples icon={icon} />
      </div>
    </div>
    <aside class="md:col-4">
      <Snippets icon={icon} />
    </aside>
  </div>
</div>
