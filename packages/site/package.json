{
  "name": "chassis-icons-site",
  "private": true,
  "description": "Documentation site of Chassis Icons",
  "type": "module",
  "scripts": {
    "dev": "astro dev --port 4324",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "test": "vitest run --dir test",
    "lint:html": "chassis-docs html-validate ../../_site --config html-validate.json",
    "lint:vnu": "chassis-docs vnu ../../_site",
    "clean": "rm -rf .astro public"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/markdown-remark": "^7.3.3",
    "@astrojs/mdx": "^8.1.0",
    "@astrojs/sitemap": "^3.7.4",
    "@chassis-ui/css": "^0.14.0",
    "@chassis-ui/docs": "^0.12.0",
    "@chassis-ui/icons": "npm:@chassis-ui/icons@^0.3.1",
    "@chassis-ui/website-tokens": "^0.1.0",
    "@floating-ui/dom": "^1.8.0",
    "@pagefind/component-ui": "^1.5.2",
    "@shikijs/transformers": "^4.5.0",
    "@stackblitz/sdk": "^1.11.1",
    "astro": "^7.4.0",
    "autoprefixer": "^10.6.1",
    "html-validate": "^11.16.2",
    "htmlparser2": "^12.0.0",
    "postcss": "^8.5.30",
    "postcss-prefix-custom-properties": "^0.1.0",
    "rehype-autolink-headings": "^7.1.0",
    "sass": "^1.105.2",
    "typescript": "^6.0.3",
    "vanilla-calendar-pro": "^3.4.0",
    "vitest": "^5.0.5",
    "vnu-jar": "26.10.12"
  }
