---
import { getConfig } from '@libs/config'
import FeatureCard from '@chassis-ui/docs/components/FeatureCard.astro'
import Code from '@chassis-ui/docs/shortcodes/Code.astro'
---

<section id="build-section" class="home-section py-3xl md:py-6xl">
  <div class="container 2xl section-content">
    <div class="row mb-3xl md:mb-6xl">
      <header class="section-header col lg:col-10 xl:col-8">
        <h2 id="build">Build</h2>
        <p>
          Get started with Chassis Icons in just a few steps. Save your icon files, build the icons,
          and import the CSS stylesheet to your project.
        </p>
      </header>
    </div>

    <div class="row row-cols-1 md:row-cols-3 g-md md:g-xl">
      <div class="col">
        <FeatureCard icon="cx-folders">
          <Fragment slot="title">Save Files</Fragment>
          <Fragment slot="body"
            >Store your icon files in organized directories for easy access.</Fragment
          >
          <div class="border-top border-subtle pt-md">
            <Code
              noToolbar
              lang="text"
              code={`svgs/
├── icon-file.svg
├── icon-file.svg
├── icon-file.svg
└── ...`}
            />
          </div>
        </FeatureCard>
      </div>
      <div class="col">
        <FeatureCard icon="cx-check-circle">
          <Fragment slot="title">Build Icons</Fragment>
          <Fragment slot="body">Use the build scripts to generate icon fonts and CSS.</Fragment>
          <div class="border-top border-subtle pt-md">
            <Code
              noToolbar
              lang="shell"
              code={`# Build icons
pnpm icons

# Build doc pages
pnpm site:pages`}
            />
          </div>
        </FeatureCard>
      </div>
      <div class="col">
        <FeatureCard icon="cx-figma">
          <Fragment slot="title">Import Files</Fragment>
          <Fragment slot="body"
            >Integrate the icon library by importing the CSS stylesheet.</Fragment
          >
          <div class="border-top border-subtle pt-md">
            <Code
              noToolbar
              lang="html"
              code={`<!-- HTML -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/chassis-icons@${getConfig().current_version}/font/chassis-icons.min.css">`}
            />
            <Code
              noToolbar
              lang="css"
              containerClass="mt-nmd"
              code={`/* CSS */
@import url("https://cdn.jsdelivr.net/npm/chassis-icons@${getConfig().current_version}/font/chassis-icons.min.css");`}
            />
          </div>
        </FeatureCard>
      </div>
    </div>
  </div>
</section>
