{
  "name": "chassis-icons-workspace",
  "private": true,
  "description": "Workspace of @chassis-ui/icons and its documentation site",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/chassis-ui/icons.git"
  },
  "author": "Ozgur Gunes <o.gunes@gmail.com>",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "pnpm icons && pnpm site:pages && pnpm site:build",
    "dev": "pnpm astro:dev",
    "release": "pnpm build && pnpm release:archives",
    "test": "pnpm icons:test",
    "icons": "pnpm --filter ./packages/icons build",
    "icons:font": "pnpm --filter ./packages/icons font",
    "icons:init": "pnpm --filter ./packages/icons init",
    "icons:lint": "eslint --cache --cache-location .cache/.eslintcache --max-warnings 0 build packages/icons/build packages/icons/test",
    "icons:lint:package": "pnpm --filter ./packages/icons lint:package",
    "icons:lint:source": "pnpm --filter ./packages/icons lint:source",
    "icons:sprite": "pnpm --filter ./packages/icons sprite",
    "icons:svgs": "pnpm --filter ./packages/icons svgs",
    "icons:test": "pnpm --filter ./packages/icons test",
    "icons:test:golden": "pnpm --filter ./packages/icons test:golden",
    "icons:typecheck": "pnpm --filter ./packages/icons typecheck",
    "icons:verify": "pnpm --filter ./packages/icons verify",
    "site": "pnpm site:build && pnpm site:lint",
    "site:pages": "node build/build-pages.js",
    "site:build": "pnpm vendor && pnpm astro:build && pnpm site:pagefind",
    "site:clean": "rm -rf _site && pnpm --filter ./packages/site clean",
    "site:lint": "pnpm site:lint:eslint && pnpm site:lint:stylelint && pnpm site:lint:prettier && pnpm site:lint:vnu",
    "site:lint:fusv": "find-unused-sass-variables packages/site/src/scss/",
    "site:lint:eslint": "eslint packages/site --cache --cache-location .cache/.eslintcache --report-unused-disable-directives",
    "site:lint:prettier": "prettier -c --cache packages/site",
    "site:lint:stylelint": "stylelint packages/site/src/scss/ --cache --cache-location .cache/.stylelintcache",
    "site:lint:html": "pnpm --filter ./packages/site lint:html",
    "site:lint:vnu": "pnpm --filter ./packages/site lint:vnu",
    "site:pagefind": "pagefind --site _site --output-subdir icons/pagefind",
    "astro:dev": "pnpm --filter ./packages/site dev",
    "astro:build": "pnpm --filter ./packages/site build",
    "astro:preview": "pnpm --filter ./packages/site preview",
    "check": "pnpm check:astro && pnpm check:pnpm",
    "check:astro": "pnpm --filter ./packages/site check",
    "check:pnpm": "pnpm audit --prod --audit-level moderate",
    "lint:prettier": "prettier -c --cache .",
    "changeset": "changeset",
    "changeset:check": "node build/check-changeset.js",
    "changeset:version": "changeset version && node build/sync-version-refs.js",
    "release:archives": "node build/release-archives.js",
    "release:notes": "node build/release-notes.js",
    "sync-submodules": "pnpm --filter ./packages/site exec chassis-docs sync-submodules",
    "vendor": "pnpm --filter ./packages/site exec chassis-docs vendor"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.6.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-astro": "^2.1.1",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-unicorn": "^70.0.0",
    "find-unused-sass-variables": "^6.2.1",
    "globals": "^17.7.0",
    "pagefind": "^1.5.2",
    "picocolors": "^1.1.1",
    "prettier": "^3.9.4",
    "prettier-plugin-astro": "^0.14.1",
    "stylelint": "^16.26.1",
    "stylelint-config-twbs-bootstrap": "^16.1.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.62.1"
  },
  "packageManager": "pnpm@10.33.2+sha512.a90faf6feeab71ad6c6e57f94e0fe1a12f5dcc22cd754db40ae9593eb6a3e0b6b12e3540218bb37ae083404b1f2ce6db2a4121e979829b4aff94b99f49da1cf8"
}
