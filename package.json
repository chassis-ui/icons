{
  "name": "chassis-icons-workspace",
  "private": true,
  "description": "Workspace of @chassis-ui/icons, the builder of icon sets, and its documentation site",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/chassis-ui/icons.git"
  },
  "author": "Ozgur Gunes <o.gunes@gmail.com>",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "pnpm site:build",
    "dev": "pnpm vendor && pnpm astro:dev",
    "test": "pnpm icons:test",
    "icons": "node packages/icons/lib/cli.js build --cwd vendor/icons",
    "icons:archive": "node packages/icons/lib/cli.js archive --cwd vendor/icons --to .cache/archives",
    "icons:font": "node packages/icons/lib/cli.js build --only font --cwd vendor/icons",
    "icons:lint": "eslint --cache --cache-location .cache/.eslintcache --max-warnings 0 build packages/icons/lib packages/icons/test",
    "icons:lint:package": "pnpm --filter ./packages/icons run lint:package",
    "icons:lint:source": "node packages/icons/lib/cli.js lint-source --cwd vendor/icons",
    "icons:native": "bash packages/icons/test/native/check.sh vendor/icons",
    "icons:preview": "node packages/icons/lib/cli.js preview --serve --cwd vendor/icons",
    "icons:sprite": "node packages/icons/lib/cli.js build --only sprite --cwd vendor/icons",
    "icons:svgs": "node packages/icons/lib/cli.js build --only svgs --cwd vendor/icons",
    "icons:test": "pnpm --filter ./packages/icons run test",
    "icons:test:golden": "pnpm --filter ./packages/icons run test:golden",
    "icons:typecheck": "pnpm --filter ./packages/icons run typecheck",
    "icons:verify": "node packages/icons/lib/cli.js verify --cwd vendor/icons",
    "site": "pnpm site:build && pnpm site:lint",
    "site:build": "pnpm vendor && pnpm astro:build && pnpm site:pagefind",
    "site:clean": "rm -rf _site && pnpm --filter ./packages/site run clean",
    "site:lint": "pnpm site:lint:eslint && pnpm site:lint:stylelint && pnpm site:lint:prettier && pnpm site:lint:vnu",
    "site:lint:fusv": "find-unused-sass-variables packages/site/src/scss/",
    "site:lint:eslint": "eslint packages/site --cache --cache-location .cache/.eslintcache --report-unused-disable-directives",
    "site:lint:prettier": "prettier -c --cache packages/site",
    "site:lint:stylelint": "stylelint packages/site/src/scss/ --cache --cache-location .cache/.stylelintcache",
    "site:lint:html": "pnpm --filter ./packages/site run lint:html",
    "site:lint:vnu": "pnpm --filter ./packages/site run lint:vnu",
    "site:test": "pnpm --filter ./packages/site run test",
    "site:pagefind": "pagefind --site _site --output-subdir icons/pagefind",
    "astro:dev": "pnpm --filter ./packages/site run dev",
    "astro:build": "pnpm --filter ./packages/site run build",
    "astro:preview": "pnpm --filter ./packages/site run preview",
    "check": "pnpm check:astro && pnpm check:pnpm",
    "check:astro": "pnpm --filter ./packages/site run check",
    "check:pnpm": "pnpm audit --prod --audit-level moderate",
    "lint:prettier": "prettier -c --cache .",
    "spellcheck": "cspell --no-progress --no-must-find-files",
    "changeset": "changeset",
    "changeset:check": "node build/check-changeset.js",
    "changeset:version": "changeset version && node build/sync-version-refs.js",
    "release:notes": "node build/release-notes.js",
    "sync-assets": "pnpm --filter ./packages/site exec chassis-docs sync-assets",
    "vendor": "git submodule update --init vendor/icons && pnpm icons && pnpm --filter ./packages/site exec chassis-docs vendor"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@eslint/js": "^10.0.1",
    "cspell": "^10.4.0",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-astro": "^3.2.1",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-unicorn": "^77.0.0",
    "find-unused-sass-variables": "^6.2.1",
    "globals": "^17.13.0",
    "pagefind": "^1.5.2",
    "picocolors": "^1.1.1",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.2",
    "stylelint": "^16.26.1",
    "stylelint-config-twbs-bootstrap": "^16.1.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1"
  },
  "packageManager": "pnpm@10.33.2+sha512.a90faf6feeab71ad6c6e57f94e0fe1a12f5dcc22cd754db40ae9593eb6a3e0b6b12e3540218bb37ae083404b1f2ce6db2a4121e979829b4aff94b99f49da1cf8"
}
